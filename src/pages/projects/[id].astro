---
import "../../styles/index.css";
import "../../styles/reset.css";
import "../projects/id.css";

import Layout from "../../layouts/Layout.astro";
import enlaceExterno from "../../assets/icons/enlace-externo-blanco.png";
import { Image } from "astro:assets";
import { projects } from "../../data/projects.ts";

export async function getStaticPaths() {
  // Genera una ruta para cada proyecto en la lista
  return projects.map((project) => ({
    params: { id: project.id.toString() }, // Convierte los IDs a string
  }));
}

const { id } = Astro.params;

// Verifica que `id` no sea undefined antes de convertirlo
if (!id) {
  throw new Error("El parámetro ID no está definido en la URL.");
}

const project = projects.find((p) => p.id === String(id));

if (!project) {
  throw new Error(`No se encontró el proyecto con ID: ${id}`);
}

const links = [project.link, project.link2].filter(Boolean); // Filtra los links no definidos
---

<Layout>
  <div class="projectid-container">
    <div class="projectid-card">
      <div class="projectid-header">
        <div class="projectid-img-wrapper">
          <Image
            class="projectid-img"
            src={project.image}
            alt={`Imagen del proyecto ${project.title}`}
          />
        </div>
        <div class="projectid-info">
          <h1 class="projectid-title">{project.title}</h1>
          <div class="projectid-info-wrapper">
            <p class="projectid-info-text">
              Fecha de realización: {project.date}
            </p>
            <div class="projectid-links">
              {
                links.map((link) => (
                  <a
                    class="projectid-link-image"
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Image
                      class="projectid-link-icon"
                      src={enlaceExterno}
                      alt="Icono de enlace externo"
                    />
                    Ver más
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
      <div class="projectid-description">
        <h2 class="projectid-title">Descripción</h2>
        <p>{project.description}</p>
      </div>
      <div class="projectid-technologies">
        <h2 class="projectid-title">Tecnologías</h2>
        <p>{project.technologies}</p>
      </div>
    </div>
  </div>
</Layout>
